FROM docker.io/library/node:24-bookworm-slim

ENV HUSKY=0
RUN corepack enable

WORKDIR /app
COPY . .
RUN yarn install --immutable

# Next.js bakes public settings into the bundle, so they are needed at build time
ARG CHAIN=hyperbridge
ARG NEXT_PUBLIC_API_END_POINT
ARG NEXT_PUBLIC_BACKEND_API_END_POINT
ARG NEXT_PUBLIC_SITE_URL
# Avatars are served by the governance API, under the site's /api proxy
ARG NEXT_PUBLIC_PREVIEW_IMG_ENDPOINT=${NEXT_PUBLIC_SITE_URL}/api/s3/files
ARG NEXT_PUBLIC_IDENTITY_SERVER_HOST=https://id.statescan.io
ARG NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.filebase.io/ipfs
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV CHAIN=$CHAIN \
	NEXT_PUBLIC_CHAIN=$CHAIN \
	NEXT_PUBLIC_API_END_POINT=$NEXT_PUBLIC_API_END_POINT \
	NEXT_PUBLIC_BACKEND_API_END_POINT=$NEXT_PUBLIC_BACKEND_API_END_POINT \
	NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
	NEXT_PUBLIC_IDENTITY_SERVER_HOST=$NEXT_PUBLIC_IDENTITY_SERVER_HOST \
	NEXT_PUBLIC_PREVIEW_IMG_ENDPOINT=$NEXT_PUBLIC_PREVIEW_IMG_ENDPOINT \
	NEXT_PUBLIC_IPFS_GATEWAY=$NEXT_PUBLIC_IPFS_GATEWAY \
	NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID

RUN yarn workspace @subsquare/next build

WORKDIR /app/packages/next
ENV NODE_ENV=production PORT=7001
EXPOSE 7001

CMD ["node", "server.mjs"]
